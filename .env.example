# KICKSCOUT environment. Never commit real values; real secrets live in your host's secret settings.
# Copy the shared + api parts to apps/api/.env, the shared + worker parts to apps/worker/.env.

# ---------------------------------------------------------------- shared (api + worker)
NODE_ENV=development
# Supabase: Project Settings > Database > connection string. Local: docker-compose postgres.
DATABASE_URL=postgres://fp:fp@localhost:5432/fp_dev
# Object storage, any S3-compatible service. Supabase Storage: https://<ref>.supabase.co/storage/v1/s3
# Cloudflare R2: https://<account>.r2.cloudflarestorage.com (region auto). Local: MinIO from docker-compose.
S3_REGION=eu-central-1
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_ORIGINALS=fp-originals

# ---------------------------------------------------------------- api
PORT=8080
# Supabase Auth issues the access tokens; the API only verifies them against the project's JWKS
# (Supabase: enable asymmetric JWT signing keys). Audience is "authenticated" for Supabase.
AUTH_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
AUTH_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1
AUTH_AUDIENCE=authenticated
# Public base URL of the delivery bucket or CDN in front of it.
CDN_BASE_URL=http://localhost:9000/fp-delivery
# openssl rand -base64 32
DOB_ENCRYPTION_KEY=
# openssl rand -hex 32
VIEWER_HASH_SECRET=
# Web app origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:3000
MAILER=log
# yes = allow MAILER=log in a labelled preview deployment (guardian emails are only logged, not sent).
ALLOW_LOG_MAILER=no
POLICY_VERSION=2026-10-draft
# Demo seed (pnpm --filter @fp/api db:seed): promo clips are read from CDN_BASE_URL/<prefix>/<stem>.mp4
DEMO_MEDIA_PREFIX=promo

# ---------------------------------------------------------------- worker
# Settings for apps/worker (copy to apps/worker/.env). The API also reads S3_FORCE_PATH_STYLE and the S3 keys.
# Processed playback files and thumbnails go here (playback/{videoId}.mp4, thumbs/{videoId}.jpg).
S3_BUCKET_DELIVERY=fp-delivery
# true for MinIO and Supabase Storage; R2 and AWS work either way.
S3_FORCE_PATH_STYLE=true
# Leave empty on AWS to use the default credential chain (AWS_* env vars or an instance role).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Without a key no video is published automatically: every upload waits for a moderator.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=high
# Server-side refusal fallbacks (Claude API only). Set false behind gateways that reject the beta.
AI_SERVER_FALLBACKS=true
WORKER_CONCURRENCY=1
JOB_TIMEOUT_MS=900000
JOB_POLL_INTERVAL_MS=2000
JOB_RETRY_BASE_MS=30000
MAX_ORIGINAL_BYTES=524288000
# Optional; default to ffmpeg/ffprobe on PATH.
FFMPEG_PATH=
FFPROBE_PATH=

# web
# Next.js web app (apps/web). Copy to apps/web/.env.local. Only NEXT_PUBLIC_* values; they ship to the browser, so never put secrets here.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Supabase Auth (email/password + Google). Leave empty to run without sign-in; the UI says auth is not configured.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Folder or CDN holding the 20 AI-generated promo clips as <stem>.mp4 + <stem>.jpg (default: /promo in apps/web/public).
NEXT_PUBLIC_PROMO_BASE_URL=/promo
# Must match the API's POLICY_VERSION; sent with consent changes.
NEXT_PUBLIC_POLICY_VERSION=2026-10-draft
