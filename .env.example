# Copy to apps/api/.env for local development. Never commit real values.
NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://fp:fp@localhost:5432/fp_dev
# Managed identity provider (Auth0, Clerk, Cognito...). The API only verifies its tokens.
AUTH_JWKS_URL=https://YOUR_TENANT.example.com/.well-known/jwks.json
AUTH_ISSUER=https://YOUR_TENANT.example.com/
AUTH_AUDIENCE=football-api
S3_REGION=eu-central-1
# Local S3-compatible storage from docker-compose (MinIO). Remove for AWS.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_ORIGINALS=fp-originals
CDN_BASE_URL=http://localhost:9000/fp-delivery
# openssl rand -base64 32
DOB_ENCRYPTION_KEY=
# openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=
MAILER=log
POLICY_VERSION=2026-10-draft
