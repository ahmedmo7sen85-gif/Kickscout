{
  "name": "kickscout",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @fp/db migrate",
    "openapi": "pnpm --filter @fp/api openapi"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.9.0"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.23": "^8.5.23",
      "fast-uri@<3.1.9": "^3.1.9",
      "fast-uri@>=4 <4.2.3": "^4.2.3"
    }
  }
}
