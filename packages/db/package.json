{
  "name": "@fp/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo 'no unit tests; covered by api integration tests'",
    "migrate": "node dist/migrate.js",
    "types": "kysely-codegen --dialect postgres --out-file src/types.ts --exclude-pattern schema_migrations"
  },
  "dependencies": {
    "kysely": "^0.28.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "kysely-codegen": "^0.19.0",
    "typescript": "^5.9.0"
  }
}
