{
  "name": "@fp/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --watch --env-file=.env dist/main.js",
    "start": "node dist/main.js",
    "test": "vitest run",
    "db:migrate": "pnpm --filter @fp/db migrate",
    "openapi": "node dist/openapi.js > openapi.json",
    "db:seed": "node dist/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fp/contracts": "workspace:*",
    "@fp/db": "workspace:*",
    "@fp/domain": "workspace:*",
    "fastify": "^5.6.0",
    "jose": "^6.1.0",
    "kysely": "^0.28.0",
    "pg": "^8.16.0",
    "uuid": "^13.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
