{
  "name": "@fp/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --watch --env-file=.env dist/main.js",
    "start": "node dist/main.js",
    "test": "vitest run",
    "db:migrate": "node dist/db/migrate.js",
    "db:types": "kysely-codegen --dialect postgres --out-file src/db/types.ts --exclude-pattern schema_migrations",
    "openapi": "node dist/openapi.js > openapi.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fp/contracts": "workspace:*",
    "@fp/domain": "workspace:*",
    "fastify": "^5.6.0",
    "jose": "^6.1.0",
    "kysely": "^0.28.0",
    "pg": "^8.16.0",
    "uuid": "^13.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "kysely-codegen": "^0.19.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
